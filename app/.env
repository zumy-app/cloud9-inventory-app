# AI assist config (P1, provider-neutral). NOTHING HERE IS COMMITTED.
# Fill in the values locally when enabling AI suggestions.
# Consumed as: --dart-define AI_API_KEY=... --dart-define AI_API_BASE_URL=... --dart-define AI_API_MODEL=...
# Example build:
#   set -a; source .env; flutter build apk --release \
#     --dart-define API_BASE=https://admin.cloud9market.net \
#     --dart-define AI_API_KEY=$AI_API_KEY \
#     --dart-define AI_API_BASE_URL=$AI_API_BASE_URL \
#     --dart-define AI_API_MODEL=$AI_API_MODEL

# Secret key for the AI provider (OpenRouter today, swappable tomorrow).
AI_API_KEY=

# Any OpenAI-compatible chat-completions endpoint.
AI_API_BASE_URL=https://openrouter.ai/api/v1

# Model id, e.g. openai/gpt-oss-20b (cheap + reliable JSON, see below).
# Alternatives: amazon/nova-micro-v1 (most reliable), mistralai/mistral-nemo.
AI_API_MODEL=openai/gpt-oss-20b
